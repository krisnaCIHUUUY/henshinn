  "fixed_sql": [
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "products",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"products\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"price\" INTEGER NOT NULL, \"cost_price\" INTEGER NOT NULL DEFAULT 0, \"stock\" INTEGER NOT NULL DEFAULT 0, \"low_stock_threshold\" INTEGER NOT NULL DEFAULT 5, \"is_active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_active\" IN (0, 1)), \"category_id\" INTEGER NOT NULL REFERENCES categories (id), \"barcode\" TEXT NULL, \"image_path\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "transactions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"transactions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"date\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"total\" INTEGER NOT NULL, \"payment_amount\" INTEGER NOT NULL, \"change\" INTEGER NOT NULL, \"status\" TEXT NOT NULL DEFAULT 'completed', \"void_reason\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "transaction_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"transaction_items\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"transaction_id\" INTEGER NOT NULL REFERENCES transactions (id), \"product_id\" INTEGER NOT NULL REFERENCES products (id), \"qty\" INTEGER NOT NULL, \"product_name\" TEXT NOT NULL DEFAULT '', \"price_at_sale\" INTEGER NOT NULL, \"cost_price_at_sale\" INTEGER NOT NULL DEFAULT 0);"
        }
      ]
    },
    {
      "name": "stock_movements",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"stock_movements\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"product_id\" INTEGER NOT NULL REFERENCES products (id), \"type\" TEXT NOT NULL, \"quantity\" INTEGER NOT NULL, \"note\" TEXT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"id\" INTEGER NOT NULL DEFAULT 1, \"store_name\" TEXT NOT NULL DEFAULT '', \"store_address\" TEXT NOT NULL DEFAULT '', \"receipt_message\" TEXT NOT NULL DEFAULT '', \"last_backup_at\" INTEGER NULL, \"schema_version\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "products_barcode_unique",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE UNIQUE INDEX products_barcode_unique ON products (barcode)"
        }
      ]
    }
  ]
